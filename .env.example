# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin Dashboard Configuration
# Set a strong password for the admin dashboard
ADMIN_PASSWORD=your_secure_admin_password

# Optional consent-aware PostHog (blank = no SDK load or PostHog requests).
# Use the PUBLIC project key, never a personal API key. Select its actual region.
# Missing or invalid region disables tracking even when a key is configured.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_REGION=us
# Preview builds require this explicit opt-in key. It may match the production
# project key or use a separate project. Events are tagged environment=preview;
# filter production dashboards by environment=production.
NEXT_PUBLIC_POSTHOG_PREVIEW_KEY=
# Hosts are derived from region: https://us.i.posthog.com or https://eu.i.posthog.com.
# Enable session replay in that project to receive consented, fully masked replay.
# Identity remains memory-only; no cross-visit/person profiles are collected.

# Preview isolation and form delivery
# `preview` keeps the host noindex and disables admin routes. Leave unset on the
# public production build. This switch remains independent from form delivery.
NEXT_PUBLIC_SITE_MODE=preview
# Preview builds are validation-only and write-free unless explicitly set to
# `live` after the database and email release gates have been verified.
NEXT_PUBLIC_FORM_MODE=

# Server-only form notifications. Never expose RESEND_API_KEY with NEXT_PUBLIC_.
RESEND_API_KEY=
# Defaults shown match lib/email-send.ts and may be overridden per environment.
ADMIN_EMAIL="hello@exotiq.ai"
FROM_EMAIL="Drive Exotiq <hello@mail.driveexotiq.com>"
REPLY_TO_EMAIL="hello@exotiq.ai"

# Netlify alias releases: scope server secrets to the alias branch as well as
# the build context. astra-review runs with branch:astra-review at runtime.

# Optional Cloudflare Web Analytics PUBLIC beacon token (32 hexadecimal chars).
# Blank disables it. Manual Netlify integration: no DNS/proxy change required.
# Production builds only; runtime allows HTTPS driveexotiq.com and www only,
# excludes /admin and /api, and disables automatic SPA pageview tracking.
# Aggregate cookieless document-load/vitals reporting, separate from PostHog.
NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# Public Meta Pixel ID; production host only, behind marketing consent.
NEXT_PUBLIC_META_PIXEL_ID=

# GA4: enable ONLY after Enhanced Measurement is disabled in the matching stream
# and generate_lead is configured as a key event. Blank keeps website GA4 off.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Server-only Measurement Protocol secret for that exact web stream.
GA4_API_SECRET=
