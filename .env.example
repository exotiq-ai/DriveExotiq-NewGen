# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin Dashboard Configuration
# Set a strong password for the admin dashboard
ADMIN_PASSWORD=your_secure_admin_password

# PostHog product analytics (optional). Same project as the renter marketplace.
# Loads only on driveexotiq.com and only after the visitor accepts analytics
# cookies — see lib/posthog.ts. Leave the key empty to disable entirely.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_REGION=us
